<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 仅允许 HTTPS 后端；如需在开发阶段允许 http 自签名，可临时放开 domain-config -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
